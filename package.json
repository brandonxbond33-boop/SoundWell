{
  "name": "soundwell",
  "version": "0.1.0",
  "private": true,
  "description": "A free, fast, accessible library of sound effects and music.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "seed": "node --no-warnings scripts/seed.js",
    "import:freesound": "node --no-warnings scripts/import-freesound.js",
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "test": "node --no-warnings --test test/*.test.js"
  }
}
